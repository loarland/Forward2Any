# 复制成 .env 后按需修改：docker compose 会自动读同目录的 .env，套进 docker-compose.yml。
# 不改也能直接起，全部走默认值。

# 宿主端口，容器内固定 16000。
F2A_HOST_PORT=16000

# 回调 URL 和 curl 示例的基址，填外部真正能访问到的地址；不填就跟着 F2A_HOST_PORT 走。
#F2A_BASE_URL=https://hooks.example.com

# 管理员。密码留空则用默认密码 f2a，登录后强制改密。
#F2A_ADMIN_USER=admin
#F2A_ADMIN_PASSWORD=换成自己的密码

F2A_LOG_LEVEL=info

# 数据目录。注释掉就用命名卷 f2a-data（容器删了重建也不丢）；
# 取消注释换成宿主机目录，方便直接 backup。
#F2A_DATA_DIR=./data

# 容器内进程的 uid / gid，默认 0（root），宿主机目录不用先 chown。
# 填非 0 就以这个身份运行（`id -u` / `id -g` 的数字），数据目录属主要和它一致：
#   F2A_UID=1000
#   F2A_GID=1000
