# 复制成 .env 后按需修改，docker compose 会自动读同目录的 .env 并套进 docker-compose.yml。
# 不改也能直接起，全部走默认值。

# 宿主端口。容器内固定 16000，只改外面这个。
F2A_HOST_PORT=16000

# 回调 URL 和 curl 示例的基址，填外部真正能访问到的地址；不填就跟着 F2A_HOST_PORT 走。
#F2A_BASE_URL=https://hooks.example.com

# 管理员。密码留空则用默认密码 f2a，登录后强制改密。
#F2A_ADMIN_USER=admin
#F2A_ADMIN_PASSWORD=换成自己的密码

F2A_LOG_LEVEL=info

# 数据目录。注释掉就用命名卷 f2a-data（容器删了重建也不丢）。
# 取消注释则换成宿主机目录，方便直接 backup / 看文件。
#F2A_DATA_DIR=./data

# 容器内进程的 uid / gid，数据目录属主会被自动改成这两个值。
# 默认 65532（镜像里的 nonroot）。Linux 上用宿主机目录时填成自己，
# 数据文件就归你所有，不用 sudo 也能读：
#   F2A_UID=1000
#   F2A_GID=1000
